{
  "name": "ak67-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Customs Law Readers suite: landing page + Customs Act 1967 reader + Customs Regulations 2019 reader",
  "workspaces": [
    "customs-act-app",
    "customs-reg-app"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-site.mjs",
    "dev:act": "npm run dev --prefix customs-act-app",
    "dev:reg": "npm run dev --prefix customs-reg-app",
    "deploy:act": "npm run deploy --prefix customs-act-app",
    "deploy:reg": "npm run deploy --prefix customs-reg-app",
    "gen:data:act": "npm run gen:data --prefix customs-act-app",
    "gen:data:reg": "npm run gen:data --prefix customs-reg-app"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
